# Which model provider powers the quiz generator. One of: gemini, claude, openai
AI_PROVIDER=gemini

# Key for whichever provider AI_PROVIDER points to. Never committed, never sent to the browser.
AI_API_KEY=change_me

# Optional: override the default model per provider
# AI_MODEL=gemini-2.5-flash

# Comma separated list of origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000
